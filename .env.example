# OpenAI / Ollama Configuration
# The API key for the LLM service. For local Ollama, this can be any string.
OPENAI_API_KEY=ollama
# The base URL for the LLM service. Defaults to local Ollama instance.
OPENAI_API_BASE=http://localhost:11434/v1

# LLM Configuration
# The model to use. Must be pulled locally (e.g. `ollama pull qwen2.5:14b`).
LLM_MODEL=qwen2.5:14b
# LLM Temperature (0.0 - 2.0):
# 0.2: Focused, deterministic (coding/math)
# 0.7: Balanced (default)
# 0.9: Creative, conversational
LLM_TEMPERATURE=0.7
# Max Tokens: Controls response length.
# 512 is good for concise conversational turns.
LLM_MAX_TOKENS=512

# TTS Configuration
# TTS Service Selection: 'xtts' or 'chatterbox' (default: chatterbox)
TTS_SERVICE=chatterbox
# The voice to use. 
# For XTTS: See docker-compose.yml for XTTS voices (e.g. 'Claribel Dervla')
# For Chatterbox: See CHATTERBOX_VOICES (e.g. 'Elena', 'Adrian')
TTS_VOICE=Elena
# Chatterbox voices: Abigail, Adrian, Alexander, Alice, Austin, Axel, Connor, Cora, Elena, Eli, Emily, Everett, Gabriel, Gianna, Henry, Ian, Jade, Jeremiah, Jordan, Julian, Layla, Leonardo, Michael, Miles, Olivia, Ryan, Taylor, Thomas
CHATTERBOX_VOICES=Abigail,Adrian,Alexander,Alice,Austin,Axel,Connor,Cora,Elena,Eli,Emily,Everett,Gabriel,Gianna,Henry,Ian,Jade,Jeremiah,Jordan,Julian,Layla,Leonardo,Michael,Miles,Olivia,Ryan,Taylor,Thomas
# Aggregator Strategy:
# - 'space_aware': Lowest latency (default). Starts on first space/newline.
# - 'sentence': More stable. Waits for full sentence + lookahead.
# - 'none': Raw token streaming. Experimental.
TTS_TEXT_AGGREGATOR=sentence

# Bot Configuration
# Path to the file containing system instructions (persona).
SYSTEM_PROMPT_PATH=instructions.md

# UltraSpec Audio Configuration
# Filter: none | noisereduce | rnnoise (Recommended)
AUDIO_FILTER=rnnoise
# Whisper Language: en | pt | auto
STT_LANGUAGE=en

# Latency Tuning (Edge Bot)
# streaming | segmented
STT_MODE=streaming
# ms between interim updates
STT_INTERIM_INTERVAL_MS=200
# VAD stop seconds
VAD_STOP_SECS=0.8

# Muting Strategy
# If true, mutes user input while bot is speaking (prevents echo but also prevents interruption)
ENABLE_STT_MUTE=false
